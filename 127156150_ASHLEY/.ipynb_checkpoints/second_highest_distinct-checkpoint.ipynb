   "source": [
    "\n",
    "n=int(input())\n",
    "array = list(map(int, input().split()))\n",
    "\n",
    "highest= array[0]\n",
    "\n",
    "second = array[0]\n",
    "\n",
    "for num in array:\n",
    "    if num > highest:\n",
    "        highest = num\n",
    "        second = highest\n",
    "    elif second < num < highest:\n",
    "        second = num\n",
    "\n",
    "idx = array.find(second)\n",
    "print(idx)"
   ]
